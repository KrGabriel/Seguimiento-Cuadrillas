# Copia este archivo como .env.local y completa las credenciales de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY

# Solo para invitar/eliminar usuarios desde el panel (nunca exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=TU-SERVICE-ROLE-KEY

# Nombre que aparecerá en el encabezado de los PDFs (opcional)
NEXT_PUBLIC_EMPRESA_NOMBRE=Cuadrillas OS

# Logo para los PDFs: URL pública (ej. Supabase Storage). Debe permitir CORS.
NEXT_PUBLIC_EMPRESA_LOGO_URL=

# Nombre del responsable que firma los reportes PDF
NEXT_PUBLIC_RESPONSABLE_NOMBRE=
